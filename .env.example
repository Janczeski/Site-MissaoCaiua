# Conexão com o Postgres
DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Senha do painel /admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Opcional: segredo para assinar as sessões do admin (padrão: a própria ADMIN_PASSWORD)
TOKEN_SECRET=
# Porta da API (local: 3051; produção: 80)
PORT=3051
# Domínio principal; os demais redirecionam para ele (produção: missaocaiua.org.br)
CANONICAL_HOST=
REDIRECT_HOSTS=
# Pixel da Meta: só carrega com META_PIXEL_ENABLED=true (texto exato), META_PIXEL_ID numérico,
# no CANONICAL_HOST (vazio = nunca carrega), com consentimento de marketing e em rota liberada.
# As rotas NÃO são variável de ambiente: ficam em META_PIXEL_ALLOWED_PATHS, no código
# (src/lib/tracking/routes.ts), e exigem novo deploy. Formato: lista de caminhos exatos
# ('/doacao') ou com parâmetro de um segmento ('/campanhas/:uuid'); /admin nunca entra.
# Lista vazia = pixel nunca carrega e o banner de cookies não aparece.
# Com META_PIXEL_ENABLED=false (padrão) nada carrega, qualquer que seja a lista.
META_PIXEL_ENABLED=false
META_PIXEL_ID=1494309866239727
