# Conexão com o Postgres
DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Senha do painel /admin
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Opcional: segredo para assinar as sessões do admin (padrão: a própria ADMIN_PASSWORD)
TOKEN_SECRET=
# Porta da API (local: 3051; produção: 80)
PORT=3051
